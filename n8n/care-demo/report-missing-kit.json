    {
      "name": "Prepare response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const reply = (status, body) => [{ json: { status, body } }];\nconst row = $input.first().json;\nif (!row.onboarding_state) return reply(503, { error: \"Demo state is unavailable\" });\nconst state = JSON.parse(row.onboarding_state);\nconst input = $('Webhook').first().json.body ?? {};\nconst action = input.action === undefined ? 'report' : input.action;\nconst initial = { kitStatus: 'delivered', firstVisitStatus: 'ready_to_book' };\nconst now = new Date().toISOString();\nconst conflict = () => reply(409, { error: 'Demo state changed. Refresh and try again.' });\nlet next = state;\nswitch (action) {\n  case 'report':\n    if (!state.request) {\n      next = { ...state, kitStatus: 'help_requested', request: {\n        reference: 'KIT-' + row.id + '-' + Date.parse(now).toString(36).toUpperCase(),\n        receivedAt: now, reviewStatus: 'open',\n      } };\n    }\n    break;\n  case 'reset':\n    next = initial;\n    break;\n  case 'book':\n    if (!['tuesday', 'thursday'].includes(input.slot)) return reply(400, { error: 'Invalid demo time' });\n    if (state.visitSlot && state.visitSlot !== input.slot) return conflict();\n    if (!state.visitSlot) next = { ...state, firstVisitStatus: 'booked', visitSlot: input.slot };\n    break;\n  case 'confirm_visit':\n    if (!state.visitSlot) return conflict();\n    if (state.firstVisitStatus !== 'confirmed') next = { ...state, firstVisitStatus: 'confirmed' };\n    break;\n  case 'in_review':\n  case 'replacement_shipped':\n  case 'replacement_received': {\n    const transitions = {\n      in_review: { from: 'open', at: 'reviewedAt', kitStatus: 'help_requested' },\n      replacement_shipped: { from: 'in_review', at: 'shippedAt', kitStatus: 'replacement_shipped' },\n      replacement_received: { from: 'replacement_shipped', at: 'resolvedAt', kitStatus: 'replacement_received' },\n    };\n    if (state.request?.reviewStatus === action) break;\n    const transition = transitions[action];\n    if (state.request?.reviewStatus !== transition.from) return conflict();\n    next = { ...state, kitStatus: transition.kitStatus, request: {\n      ...state.request, reviewStatus: action, [transition.at]: now,\n    } };\n    break;\n  }\n  default:\n    return reply(400, { error: 'Invalid demo action' });\n}\n\nconst serialized = JSON.stringify(next);\nif (serialized === row.onboarding_state) return reply(200, state);\nreturn [{ json: { previous: row.onboarding_state, next: serialized } }];"
      },
      "id": "5edfce14-bfa5-4800-a3db-8aa1d95ec8d1"
    },
