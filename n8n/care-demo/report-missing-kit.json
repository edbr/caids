      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst statusByReview = {\n  open: \"help_requested\",\n  in_review: \"help_requested\",\n  replacement_shipped: \"replacement_shipped\",\n  replacement_received: \"replacement_received\",\n};\nconst firstVisitStatus = \"ready_to_book\";\nif (!row.requestKey) {\n  throw new Error(\"Missing-kit request was not saved\");\n}\nif (!Object.hasOwn(statusByReview, row.reviewStatus) || !row.createdAt) {\n  throw new Error(\"Unexpected missing-kit request state\");\n}\nreturn [{ json: {\n  kitStatus: statusByReview[row.reviewStatus],\n  firstVisitStatus,\n  request: {\n    reference: \"KIT-\" + row.id,\n    receivedAt: row.createdAt,\n    reviewStatus: row.reviewStatus,\n    reviewedAt: row.reviewedAt || undefined,\n    shippedAt: row.shippedAt || undefined,\n    resolvedAt: row.resolvedAt || undefined,\n  },\n} }];"
